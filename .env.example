# SBA-Auth deployment configuration. Read by server/sba-env.ts
# (`sbaConfigFromEnv`). None of these values is a secret: anyone who reads
# this file learns who is authorized and still cannot sign as any of them.
# Keep it in change-controlled deployment configuration, not a vault.
# Every variable is required; a missing, empty, zero, or malformed value
# refuses to start.

# Chain the registry is deployed on (42161 = Arbitrum One, 31337 = anvil).
SBA_CHAIN_ID=

# This organization's enrollment registry (SoulboundAuthToken or any
# ISBAIdentity-compatible contract). Also the EIP-712 verifyingContract:
# every signature is bound to it.
SBA_REGISTRY=

# The audience string every signature names and the signer's wallet
# displays. Unique per service: services that share a registry and a
# purpose accept each other's envelopes.
SBA_PURPOSE="Treasury Console"

# Identity salt; must match the salt compiled into the registry. Forks set
# their own.
SBA_IDENTITY_SALT=SBA_SALT_V1

# Enrolled identity values (bytes32, from the registry's identityOf) that
# are authorized on this console, comma-separated. Onboarding is one
# enrollment and one new entry; offboarding is deleting the entry and
# redeploying.
SBA_ALLOWLIST=
